# Copy this file to ".env" and fill in your own values before running the server.
#   cp .env.example .env

# Port the BIGTECH server listens on. Optional — defaults to 3000 if not set.
PORT=3000

# Secret used to sign admin login tokens (JWT). REQUIRED for production use.
# Generate a strong random value, for example by running:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If this is left unset, the server falls back to an insecure default secret
# and prints no warning — always set your own value before deploying.
JWT_SECRET=replace_this_with_a_long_random_string

# API key for the "Remove Background" button on the Add/Edit Product page.
# Get one free at https://www.remove.bg/api (sign up, then find it under
# Dashboard -> API Key). The free tier gives ~50 images/month at preview
# resolution; paid credits unlock full-resolution results.
# Required only if you want to use background removal — everything else on
# the site works fine without it.
REMOVE_BG_API_KEY=replace_this_with_your_remove_bg_api_key
